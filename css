/* style.css */

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
  font-family: Arial, sans-serif;
}

body{
  background:#f4f4f4;
  color:#333;
}

.navbar{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:20px 60px;
  background:#111827;
  color:white;
}

.logo{
  font-size:24px;
  font-weight:bold;
}

.nav-links{
  display:flex;
  list-style:none;
  gap:20px;
}

.nav-links a{
  text-decoration:none;
  color:white;
  transition:0.3s;
}

.nav-links a:hover{
  color:#60a5fa;
}

.hero{
  height:80vh;
  display:flex;
  justify-content:center;
  align-items:center;
  text-align:center;
  background:linear-gradient(to right,#2563eb,#1e3a8a);
  color:white;
  padding:20px;
}

.hero-content h1{
  font-size:50px;
  margin-bottom:20px;
}

.hero-content p{
  font-size:20px;
  margin-bottom:30px;
}

button{
  padding:12px 25px;
  border:none;
  background:white;
  color:#2563eb;
  font-size:16px;
  border-radius:5px;
  cursor:pointer;
  transition:0.3s;
}

button:hover{
  background:#dbeafe;
}

.features{
  display:flex;
  justify-content:center;
  gap:30px;
  padding:60px 20px;
  flex-wrap:wrap;
}

.card{
  background:white;
  padding:30px;
  width:300px;
  border-radius:10px;
  text-align:center;
  box-shadow:0 4px 10px rgba(0,0,0,0.1);
}

.card h2{
  margin-bottom:15px;
  color:#2563eb;
}

footer{
  background:#111827;
  color:white;
  text-align:center;
  padding:20px;
}

@media(max-width:768px){

  .navbar{
    flex-direction:column;
    gap:15px;
  }

  .hero-content h1{
    font-size:35px;
  }

  .hero-content p{
    font-size:18px;
  }
}
